# GitHub credentials: explicit token overrides gh auth token discovery.
GITHUB_TOKEN=
GITHUB_USERNAME=

# Antigravity CLI must be installed/authenticated independently of GitHub.
AI_PROVIDER=antigravity
ANTIGRAVITY_CLI=agy
MODEL_NAME=gemini-3.8-flash-high
SYNC_IDE_MODEL=false
ANTIGRAVITY_CONVERSATION_ID=

# Alternative direct API providers: gemini, anthropic, openai, or auto.
# Set MODEL_NAME to an ID supported by that provider.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Safe default; --live explicitly enables GitHub writes.
DRY_RUN=true
AUTO_TEST_VERIFICATION=true
CHECK_READ_DISCUSSIONS=true
ENGAGE_DISCUSSIONS=true

# Max concurrent issue repairs, separate from inbox polling.
INBOX_POLL_INTERVAL=60
ISSUE_HUNT_INTERVAL=300
MAX_CONCURRENT_TASKS=3
TARGET_LANGUAGES=python,typescript,javascript,go,rust
MIN_REPO_STARS=1000
TARGET_LABELS=good first issue,help wanted,bug
MAX_PRS_PER_DAY=5
MIN_RATE_LIMIT_REMAINING=100

# Prebuilt Docker image with project test dependencies, required off macOS.
# Native macOS sandbox-exec is the fallback. Host tests are dry-run only.
SANDBOX_IMAGE=
ALLOW_HOST_TESTS=false
# List only repositories whose CLA you have already accepted.
ACCEPTED_CLA_REPOS=
