# ==============================================================================
# Autonomous GitHub Agent Configuration
# ==============================================================================

# Google Gemini API Key (Required for AI code analysis & response generation)
# Get your key at: https://aistudio.google.com/app/api-keys
GEMINI_API_KEY=

# GitHub Personal Access Token (Optional if 'gh auth login' is already configured)
# If provided, overrides 'gh' CLI token.
GITHUB_TOKEN=

# GitHub username (Optional; auto-resolved from `gh api user` if empty)
GITHUB_USERNAME=

# Active reasoning model (also accepts GEMINI_MODEL; Antigravity session auto-detects)
# Allowed: gemini-3.8-flash, gemini-3.7-flash, gemini-3.6-flash, gemini-3.1-pro,
#          gemini-2.5-flash, gemini-2.5-pro, claude-sonnet-4.6, claude-opus-4.6, gpt-oss-120b
MODEL_NAME=gemini-3.8-flash

# Operational Mode
# DRY_RUN=true : Previews actions, prints proposed replies & PRs without modifying GitHub.
# DRY_RUN=false: Submits real PRs and comments.
DRY_RUN=true

# Concurrency & Intervals (in seconds)
INBOX_POLL_INTERVAL=60
ISSUE_HUNT_INTERVAL=300
MAX_CONCURRENT_TASKS=3

# Target Repositories & Search Criteria
# Comma-separated topics or languages to hunt issues in
TARGET_LANGUAGES=python,typescript,javascript,go,rust
MIN_REPO_STARS=1000
TARGET_LABELS=good first issue,help wanted,bug

# Safety & Rate Limits
MAX_PRS_PER_DAY=5
MIN_RATE_LIMIT_REMAINING=100
AUTO_TEST_VERIFICATION=true
